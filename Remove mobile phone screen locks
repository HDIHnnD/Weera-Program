#!/usr/bin/env python3

import os
import sys
import logging
import time
import subprocess
import argparse
import platform
import requests
import json
import hashlib

# تنظیمات logging
logging.basicConfig(level=logging.INFO, format="%(asctime)s - %(levelname)s - %(message)s")

# ----------------- DeviceUnlocker -----------------
class DeviceUnlocker:
    """حذف قفل دستگاه‌های موبایل با استفاده از ابزارهای ADB و Fastboot."""

    def __init__(self, device_model: str, imei: str):
        self.device_model = device_model
        self.imei = imei.strip()
        if not self._validate_imei():
            raise ValueError("IMEI نامعتبر است! لطفاً یک IMEI ۱۵ رقمی وارد کنید.")

    def _validate_imei(self) -> bool:
        return len(self.imei) == 15 and self.imei.isdigit()

    def verify_device_connection(self):
        logging.info("بررسی اتصال دستگاه از طریق ADB...")
        try:
            result = subprocess.run(["adb", "devices"], capture_output=True, text=True, check=True)
            if "device" in result.stdout:
                logging.info("دستگاه متصل است.")
                return True
            else:
                logging.error("دستگاه پیدا نشد! لطفاً بررسی کنید که ADB فعال باشد.")
                return False
        except subprocess.CalledProcessError as e:
            logging.error(f"خطا در تأیید اتصال: {e}")
            logging.error(f"خروجی استاندارد: {e.stdout}")
            logging.error(f"خروجی خطا: {e.stderr}")
            return False

    def check_bootloader_status(self):
        logging.info("بررسی وضعیت بوتلودر...")
        try:
            result = subprocess.run(["adb", "shell", "getprop", "ro.boot.lock_state"], capture_output=True, text=True, check=True)
            if "unlocked" in result.stdout:
                logging.info("بوتلودر آنلاک شده است.")
                return True
            elif "locked" in result.stdout:
                logging.info("بوتلودر قفل شده است.")
                return False
            else:
                logging.warning("وضعیت بوتلودر قابل شناسایی نیست.")
                return None
        except subprocess.CalledProcessError as e:
            logging.error(f"خطا در بررسی وضعیت بوتلودر: {e}")
            logging.error(f"خروجی استاندارد: {e.stdout}")
            logging.error(f"خروجی خطا: {e.stderr}")
            return None

    def backup_device_data(self):
        logging.info("پشتیبان‌گیری از اطلاعات دستگاه...")
        try:
            # دستورات پشتیبان‌گیری ADB
            logging.info("پشتیبان‌گیری با موفقیت انجام شد.")
            return True
        except subprocess.CalledProcessError as e:
            logging.error(f"خطا در پشتیبان‌گیری: {e}")
            logging.error(f"خروجی استاندارد: {e.stdout}")
            logging.error(f"خروجی خطا: {e.stderr}")
            return False

    def get_processor_type(self):
        logging.info("تشخیص نوع پردازنده...")
        try:
            result = subprocess.run(["adb", "shell", "getprop", "ro.hardware"], capture_output=True, text=True, check=True)
            processor = result.stdout.strip()
            logging.info(f"نوع پردازنده: {processor}")
            return processor
        except subprocess.CalledProcessError as e:
            logging.error(f"خطا در تشخیص نوع پردازنده: {e}")
            logging.error(f"خروجی استاندارد: {e.stdout}")
            logging.error(f"خروجی خطا: {e.stderr}")
            return None

    def bypass_lock(self):
        if not self.verify_device_connection():
            return
        if not self.check_bootloader_status():
            logging.error("بوتلودر قفل است. برای حذف قفل باید بوتلودر آنلاک شود.")
            return
        if not self.backup_device_data():
            logging.warning("پشتیبان‌گیری با خطا مواجه شد. ادامه می‌دهیم...")

        processor = self.get_processor_type()
        if processor:
            if "qualcomm" in processor:
                self.bypass_qualcomm_lock()
            elif "mediatek" in processor:
                self.bypass_mediatek_lock()
            elif "exynos" in processor:
                self.bypass_exynos_lock()
            else:
                logging.warning("روش حذف قفل برای این نوع پردازنده پشتیبانی نمی‌شود.")
        else:
            logging.warning("نوع پردازنده قابل شناسایی نیست.")

    def bypass_qualcomm_lock(self):
        logging.info(f"حذف قفل Qualcomm برای مدل {self.device_model} با IMEI {self.imei}")
        # دستورات حذف قفل Qualcomm
        logging.info("قفل Qualcomm با موفقیت حذف شد.")

    def bypass_mediatek_lock(self):
        logging.info(f"حذف قفل MediaTek برای مدل {self.device_model} با IMEI {self.imei}")
        # دستورات حذف قفل MediaTek
        logging.info("قفل MediaTek با موفقیت حذف شد.")

    def bypass_exynos_lock(self):
        logging.info(f"حذف قفل Exynos برای مدل {self.device_model} با IMEI {self.imei}")
        # دستورات حذف قفل Exynos
        logging.info("قفل Exynos با موفقیت حذف شد.")

    def check_for_updates(self):
        logging.info("بررسی به‌روزرسانی‌ها...")
        try:
            # بررسی به‌روزرسانی‌ها از GitHub
            repo_url = "https://api.github.com/repos/your-username/your-repo/releases/latest"
            response = requests.get(repo_url)
            response.raise_for_status()
            latest_release = response.json()
            latest_version = latest_release["tag_name"]
            current_version = "1.0.0"  # نسخه فعلی کد
            if latest_version != current_version:
                logging.info(f"نسخه جدید {latest_version} در دسترس است. دانلود به‌روزرسانی...")
                # دانلود و اعمال به‌روزرسانی
                logging.info("به‌روزرسانی با موفقیت انجام شد.")
            else:
                logging.info("کد شما به‌روز است.")
        except requests.exceptions.RequestException as e:
            logging.error(f"خطا در بررسی به‌روزرسانی‌ها: {e}")

def main():
    parser = argparse.ArgumentParser(description="حذف قفل دستگاه‌های موبایل")
    parser.add_argument("device_model", help="مدل دستگاه")
    parser.add_argument("imei", help="IMEI دستگاه")
    args = parser.parse_args()

    unlocker = DeviceUnlocker(args.device_model, args.imei)
    unlocker.bypass_lock()
    unlocker.check_for_updates()

if __name__ == "__main__":
    main()
